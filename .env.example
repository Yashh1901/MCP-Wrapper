# ============================================================
# MCP DB Wrapper — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to source control!
# ============================================================

# --- Server Settings ---
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_TRANSPORT=both          # stdio | http | both
MCP_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# --- Security ---
MCP_API_KEY=your-secret-api-key-here          # HTTP transport auth key
MCP_ENABLE_TLS=false                          # true for production
MCP_TLS_CERT_PATH=                            # /path/to/cert.pem
MCP_TLS_KEY_PATH=                             # /path/to/key.pem

# --- Policy config path ---
MCP_POLICY_PATH=policies/policies.yaml

# --- Connections config path ---
MCP_CONNECTIONS_PATH=config/connections.yaml

# ============================================================
# Database Connection Strings (can override connections.yaml)
# ============================================================

# PostgreSQL
POSTGRES_URL=postgresql://user:password@localhost:5432/mydb
# or separately:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydb
POSTGRES_SSL=false

# MySQL
MYSQL_URL=mysql://user:password@localhost:3306/mydb
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=myuser
MYSQL_PASSWORD=mypassword
MYSQL_DB=mydb

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=mydb
MONGODB_USER=
MONGODB_PASSWORD=

# SQLite
SQLITE_PATH=./data/mydb.sqlite

# Redis
REDIS_URL=redis://localhost:6379/0

# MSSQL / SQL Server
MSSQL_URL=mssql+pyodbc://user:password@localhost:1433/mydb?driver=ODBC+Driver+17+for+SQL+Server

# Supabase
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_DB_URL=postgresql://postgres:password@db.yourproject.supabase.co:5432/postgres
